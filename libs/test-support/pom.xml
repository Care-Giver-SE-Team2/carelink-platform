<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
	  What every service's tests share: one MySQL and one Redis container for the whole run, each
	  test class with a database of its own (SharedMySql, SharedRedis), and the real exception handler
	  for standalone MockMvc controller tests. Services depend on it with <scope>test</scope>.
	-->
	<parent>
		<groupId>sg.nus</groupId>
		<artifactId>carelink-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>test-support</artifactId>
	<name>test-support</name>
	<description>Shared test helpers: MySQL and Redis containers, the exception handler for controller tests</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-test</artifactId>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
		</dependency>
		<!-- GlobalExceptionHandlerTestSupport hands out the shared exception handler -->
		<dependency>
			<groupId>sg.nus</groupId>
			<artifactId>shared</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>
</project>
