<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Parent of every service. The Java version, the dependency versions and the test,
	  coverage and analysis plugins are decided here once, so every service is built,
	  tested and measured the same way. A service's own pom.xml lists its dependencies
	  and anything that is genuinely its own, nothing else.

	  A change here rebuilds every service in the pipeline (see .github/workflows/ci.yml).
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>sg.nus</groupId>
	<artifactId>carelink-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>carelink-platform</name>
	<description>CareLink platform: parent of all services</description>

	<modules>
		<module>libs/shared</module>
		<module>libs/platform-security</module>
		<module>libs/core-api</module>
		<module>libs/events</module>
		<module>libs/test-support</module>
		<module>services/core</module>
		<module>services/notification</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<archunit.version>1.5.1</archunit.version>
		<jacoco.version>0.8.15</jacoco.version>
		<dependency.check.version>13.0.0</dependency.check.version>
		<sonar.version>5.7.0.6970</sonar.version>
		<testcontainers.version>2.0.5</testcontainers.version>
		<shedlock.version>7.10.1</shedlock.version>
		<aws-sdk.version>2.55.14</aws-sdk.version>
		<!--
		  Security fixes that Spring Boot 4.1.1 does not manage yet. The dependency scan
		  found fixable CRITICAL CVEs in Tomcat 11.0.24 and HIGH ones in Jackson 3.1.5;
		  these are the latest patch releases of the same lines. Delete both lines once a
		  Spring Boot release manages these versions or later ones.
		-->
		<tomcat.version>11.0.26</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<!--
		  Excluded from coverage because there is no logic to cover. Measuring these
		  only invites tests that assert a getter returns what was set, which find
		  nothing and make people resent writing tests. Domain models, mappers,
		  services and controllers are deliberately NOT excluded.
		-->
		<sonar.coverage.exclusions>
			**/*Application.java,
			**/dto/**,
			**/*JpaEntity.java,
			**/*JpaRepository.java,
			**/config/**,
			**/package-info.java
		</sonar.coverage.exclusions>
		<sonar.coverage.jacoco.xmlReportPaths>
			${project.build.directory}/site/jacoco/jacoco.xml
		</sonar.coverage.jacoco.xmlReportPaths>
		<!--
		  JPA entities are structurally repetitive by nature (one field, one getter, one
		  setter per column); duplication detection on them reports noise, not a defect.
		-->
		<sonar.cpd.exclusions>
			**/*JpaEntity.java
		</sonar.cpd.exclusions>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- SNS and SQS for events between services (libs/events) -->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${aws-sdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
			<!-- One replica at a time runs each scheduled job (see the services' SchedulerLocks) -->
			<dependency>
				<groupId>net.javacrumbs.shedlock</groupId>
				<artifactId>shedlock-spring</artifactId>
				<version>${shedlock.version}</version>
			</dependency>
			<dependency>
				<groupId>net.javacrumbs.shedlock</groupId>
				<artifactId>shedlock-provider-jdbc-template</artifactId>
				<version>${shedlock.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!--
				  Kept for local use only; the pipeline scans with Trivy instead.
				  Dependency-Check rebuilds the entire NVD corpus on the machine that runs
				  it - measured at roughly four and a half hours from cold, with an NVD API
				  key making no difference - which is tolerable on a developer machine where
				  the database persists, and not tolerable on a stateless CI runner.
				  Run it by hand when a second opinion or an OWASP-format report is wanted:
				      ./mvnw -f services/<name>/pom.xml dependency-check:check -DnvdApiKeyEnvironmentVariable=NVD_API_KEY
				-->
				<plugin>
					<groupId>org.owasp</groupId>
					<artifactId>dependency-check-maven</artifactId>
					<version>${dependency.check.version}</version>
					<configuration>
						<failBuildOnCVSS>7</failBuildOnCVSS>
						<formats>
							<format>HTML</format>
							<format>JSON</format>
						</formats>
						<!-- Analysers we have no use for; leaving them on only costs time -->
						<assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
						<nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
						<nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- Surefire runs *Test only; *IT integration tests belong to failsafe -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/*IT.java</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- Coverage: produces jacoco.xml for SonarCloud to read -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<!-- Include integration coverage when the integration profile is active. -->
						<phase>verify</phase>
						<goals><goal>report</goal></goals>
					</execution>
					<!--
					  The domain-layer coverage threshold, the same for every service. It is
					  scoped to domain packages on purpose: that is where the business rules
					  and the design patterns live, it is plain Java that tests cheaply, and
					  a blanket threshold across DTOs and JPA entities would only produce
					  tests that assert nothing.
					-->
					<execution>
						<id>check-domain-coverage</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
						<configuration>
							<haltOnFailure>true</haltOnFailure>
							<rules>
								<rule>
									<element>PACKAGE</element>
									<includes>
										<include>sg.nus.carelink.*.domain.*</include>
									</includes>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- mvn verify -Pintegration -->
		<profile>
			<id>integration</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
