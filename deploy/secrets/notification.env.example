# Copy to infra/.local/<environment>/notification.env and replace every placeholder.
DB_URL=jdbc:mysql://replace-db-host.invalid:3306/carelink_notification?connectionTimeZone=Asia/Singapore&sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/etc/carelink/rds/rds-ca.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit
DB_USER=notification
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SPRING_DATA_REDIS_HOST=replace-redis-host.invalid
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
SPRING_DATA_REDIS_SSL_ENABLED=true
CARELINK_EVENTS_QUEUEURL=https://sqs.ap-southeast-1.amazonaws.com/000000000000/REPLACE_WITH_NOTIFICATION_QUEUE
# notification publishes ProviderUpdated (the Open Platform's providers) to the platform's topic
CARELINK_EVENTS_TOPICARN=arn:aws:sns:ap-southeast-1:000000000000:REPLACE_WITH_EVENTS_TOPIC
# Encrypts providers' webhook signing secrets and the Open Platform's token key in the database: 32 random bytes, base64 (openssl rand -base64 32).
# Keep it for the life of the environment; a new key cannot read the secrets the old one encrypted.
CARELINK_WEBHOOKS_ENCRYPTIONKEY=REPLACE_WITH_BASE64_32_BYTE_KEY
