# Copy to infra/.local/<environment>/notification.env and replace every placeholder.
DB_URL=jdbc:mysql://replace-db-host.invalid:3306/carelink_notification?connectionTimeZone=Asia/Singapore&sslMode=VERIFY_IDENTITY
DB_USER=notification
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SPRING_DATA_REDIS_HOST=replace-redis-host.invalid
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
SPRING_DATA_REDIS_SSL_ENABLED=true
CARELINK_EVENTS_QUEUEURL=https://sqs.ap-southeast-1.amazonaws.com/000000000000/REPLACE_WITH_NOTIFICATION_QUEUE
