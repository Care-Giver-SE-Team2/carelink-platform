# Copy to infra/.local/<environment>/visit.env and replace every placeholder.
DB_URL=jdbc:mysql://replace-db-host.invalid:3306/carelink_visit?connectionTimeZone=Asia/Singapore&sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/etc/carelink/rds/rds-ca.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit
DB_USER=visit
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SPRING_DATA_REDIS_HOST=replace-redis-host.invalid
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
SPRING_DATA_REDIS_SSL_ENABLED=true
CARELINK_EVENTS_TOPICARN=arn:aws:sns:ap-southeast-1:000000000000:REPLACE_WITH_ENVIRONMENT_TOPIC
