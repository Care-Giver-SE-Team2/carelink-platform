@startuml UC-CG03-CG05-activity
title UC-CG03 + UC-CG05 — Late Arrival and Self Check-out

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #3C4652
  DiamondBackgroundColor #FFF8E8
  DiamondBorderColor #B7791F
}

|Caregiver|
start
:Open assigned visit and read the approved care plan;
note right
Objects read: Visit,
CarePlanSnapshot
end note

|System / Visit state|
:Verify assignee, time window and current state;
:Retain SYS03 alert without pausing service;
if (Legal state transition?) then (yes)
  :Append SCHEDULED → ARRIVED
  (or proven legacy SYS03 EXCEPTION → ARRIVED)
  [VisitStateTransition = APPLIED];
else (no)
  :Append rejected transition
  [VisitStateTransition = REJECTED];
  |Caregiver|
  :Show the rejection reason;
  stop
endif

|Caregiver|
:Check in and begin care;
|System / Visit state|
:Set Visit = IN_PROGRESS;

repeat
  |Caregiver|
  :Perform each planned task;
  :Record task outcome and observations;
  note right
  Object written: VisitTask
  end note
  :Optionally record vital signs;
  note right
  VitalSign / health observation.
  Evidence upload remains future scope.
  end note

  if (Care exception found?) then (yes)
    :Report facts and severity (UC-CG04);
    |System / Visit state|
    :Create Incident [source = CAREGIVER]
    and set Visit = EXCEPTION;
    |Manager|
    :Hand off to UC-MG05 / UC-SYS02
    for take-over and escalation;
    stop
  endif

  |System / Visit state|
  :Keep actual task and material status;
repeat while (Continue care?) is (yes)

|Caregiver|
:Review non-blocking missing-material notice;
:Click Check out;
|System / Visit state|
:Verify assignee, version, real check-in and time order;
:Record server departure time;
:Append IN_PROGRESS → COMPLETED
[VisitStateTransition = APPLIED];
:Set Visit = COMPLETED
(awaiting elder);
:Preserve pending tasks, health facts and existing alerts;

|Elder|
:May review the completed visit independently (existing EL01);
if (Confirm service?) then (yes)
  |System / Visit state|
  :Create ElderConfirmation = CONFIRMED;
  :Keep Visit = COMPLETED;
  stop
elseif (Dispute?) then (yes)
  |System / Visit state|
  :Create ElderConfirmation = DISPUTED
and open Incident;
  |Manager|
  :Hand off to UC-MG05;
  stop
else (no response)
  :No additional approval is needed for check-out;
  stop
endif
@enduml
